# Production settings for docker-compose.prod.yml. Copy to .env.prod and fill in.
DJANGO_SECRET_KEY=generate-with-python-secrets-token_urlsafe-50
DJANGO_DEBUG=false
# Hosts the API answers to: the VPS address and/or its public hostname.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,api.example.com
# The Vercel URL of the frontend (the browser's origin).
CSRF_TRUSTED_ORIGINS=https://uemp.vercel.app
COOKIE_SECURE=true

POSTGRES_DB=uemp
POSTGRES_USER=uemp
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Seed the demo university on first boot so evaluators can log in straight away.
SEED_DEMO_DATA=true
